{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "AquariumData2026": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "aquarium-data-fetcher",
    "UseTls": false,
    "KeepAliveSeconds": 30,
    "ReconnectDelaySeconds": 5
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "admin",
    "Password": "admin",
    "ExchangeName": "aquarium.telemetry",
    "RoutingKey": "aquarium.measurements",
    "Durable": true
  },
  "RegistryApi": {
    "BaseUrl": "http://localhost:5011/",
    "FreshWaterAquariumsPath": "/api/FreshWaterAquarium",
    "SeaWaterAquariumsPath": "/api/SeaWaterAquarium",
    "TimeoutSeconds": 10,
    "ServiceKey": "ChangeThisServiceApiKey!"
  },
  "Topics": {
    "UseHardCodedTopics": false,
    "TopicTemplate": "aquariums/{aquariumId}/measurements",
    "HardCodedTopics": [
      "aquariums/demo-reef/measurements",
      "aquariums/demo-freshwater/measurements"
    ]
  },
  "BinaryPayload": {
    "ExpectedVersion": 1
  }
}
